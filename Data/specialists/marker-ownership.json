  "ownership_conflicts": [
    {
      "marker": "Triglycerides",
      "owner": "cardiologist",
      "co_owners": [
        "gastroenterologist"
      ],
      "rule": "The cardiologist gives the primary conclusion in the context of cardiovascular risk. The gastroenterologist comments only on its association with metabolic syndrome and the liver; the primary conclusion is not duplicated."
    },
    {
      "marker": "CRP (C-reactive protein)",
      "owner": "cardiologist",
      "co_owners": [
        "ent",
        "dermatologist"
      ],
      "rule": "The cardiologist gives the primary conclusion in the context of vascular inflammation. The ENT specialist interprets it in the context of focal infection, and the dermatologist in the context of widespread dermatosis. The primary conclusion is not duplicated"
    }
  ],
  "ownership_rules": [
    "When an ownership_conflicts record exists, the owner field specialist gives the primary conclusion for the marker",
    "Co-owners may comment on a marker in their context, but must not repeat the owner's conclusion — this is the duplication antipattern from Block 10 of the holistic framework",
    "The visit_glob field is a hint, not an exhaustive filter. File selection follows the procedure in Block 3 of the specialist contract through _index.json",
    "Canonical marker names and units — Data/labs/_marker-aliases.json"
  ],
  "updated": "2026-07-31",
  "_note": "The file describes specialist AREAS OF RESPONSIBILITY, not the patient's condition. It contains no patient claims: relevant_conditions was removed because it stored ready-made conclusions, some of which were refuted by current tests. The specialist builds the clinical picture from Data/profile.json and Data/labs/.",
  "_fields": {
    "primary_markers": "Markers for which the specialist gives the primary conclusion",
    "secondary_markers": "Markers the specialist interprets in context but does not own",
    "red_flags": "Conditional clinical escalation rules. They are formulated as conditions, not claims about a patient",
    "visit_hint": "Hint for finding visits. This is not an exhaustive filter; selection follows the specialist contract in Block 3 through visits/_index.json"
  }

# Переменные окружения дашборда.
#
# Скопируйте этот файл в `.env.local` и заполните нужное:
#   cp .env.example .env.local
#
# Все переменные опциональны. Без них дашборд работает — просто разделы
# «Задачи» и «WHOOP» вернут 502 с понятным сообщением вместо данных.
# Остальные одиннадцать разделов не зависят ни от одной из них.
#
# `.env.local` исключён из git: там ваши личные токены.

# ─── Todoist ────────────────────────────────────────────────────────
# Нужен для раздела «Задачи».
# Токен: Todoist → Settings → Integrations → Developer → API token
TODOIST_API_TOKEN=
# ID проекта, откуда брать задачи. Виден в URL проекта в веб-версии
TODOIST_PROJECT_ID=

# ─── WHOOP ──────────────────────────────────────────────────────────
# Нужны для раздела «WHOOP»: сон, восстановление, нагрузка.
#
# ⚠️  Здесь хранится пароль от аккаунта открытым текстом. Это приемлемо
#     только на своей машине и при правах 600 на файл:
#         chmod 600 .env.local
#     Если такой вариант вас не устраивает — не заполняйте эти поля
#     и пользуйтесь MCP-сервером WHOOP из основного проекта.
WHOOP_EMAIL=
WHOOP_PASSWORD=

# Каталог с кешем метрик WHOOP. По умолчанию — `Cache/whoop` в корне проекта.
# Задайте, если кеш лежит в другом месте
HEALTH_OS_WHOOP_DIR=

# Dashboard environment variables.
#
# Copy this file to `.env.local` and fill in the values you need:
#   cp .env.example .env.local
#
# All variables are optional. Without them, the dashboard still works:
# the Tasks and WHOOP sections return 502 with an explanatory message
# instead of data. The other eleven sections do not depend on these variables.
#
# `.env.local` is excluded from Git: it contains your personal tokens.

# ─── Todoist ────────────────────────────────────────────────────────
# Required for the Tasks section.
# Token: Todoist → Settings → Integrations → Developer → API token
TODOIST_API_TOKEN=
# Project ID to fetch tasks from. Visible in the project's web URL
TODOIST_PROJECT_ID=

# ─── WHOOP ──────────────────────────────────────────────────────────
# Required for the WHOOP section: sleep, recovery, and strain.
#
# ⚠️  The account password is stored here in plain text. This is acceptable
#     only on your own machine with file permissions set to 600:
#         chmod 600 .env.local
#     If this arrangement is unacceptable, leave these fields blank
#     and use the WHOOP MCP server from the main project.
WHOOP_EMAIL=
WHOOP_PASSWORD=

# WHOOP metrics cache directory. Defaults to `Cache/whoop` in the project root.
# Set this if the cache is stored elsewhere
HEALTH_OS_WHOOP_DIR=

{
  "_comment": [
    "MCP server configuration template. Copy to .mcp.json and enter your own values.",
    ".mcp.json is excluded from Git because it contains keys and local paths.",
    "All integrations are optional: the system works fully without any of them.",
    "Store keys with permissions 600 and never paste them into prompts or tasks."
  ],

  "mcpServers": {
    "_whoop": {
      "_note": "Sleep, recovery, and strain metrics. Remove the leading underscore from the name to enable.",
      "_setup": "Requires a locally installed WHOOP MCP server. Specify the path to its entry point.",
      "command": "npx",
      "args": ["tsx", "/ABSOLUTE/PATH/TO/whoop-mcp/index.ts"],
      "env": {}
    },

    "_google-calendar": {
      "_note": "Appointments and booster vaccination reminders. Remove the leading underscore to enable.",
      "_setup": "On first launch, a browser opens for OAuth authorization.",
      "command": "npx",
      "args": ["-y", "@cocal/google-calendar-mcp"],
      "env": {}
    },

    "_todoist": {
      "_note": "Health tasks: follow-up appointments and repeat lab tests. Remove the leading underscore to enable.",
      "_setup": "Get the token from Todoist settings: Settings → Integrations → Developer.",
      "command": "npx",
      "args": ["-y", "@doist/todoist-mcp"],
      "env": {
        "TODOIST_API_KEY": "<YOUR_TOKEN>"
      }
    }
  }
}

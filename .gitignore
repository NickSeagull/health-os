# ═══════════════════════════════════════════════════════════════════
#  МЕДИЦИНСКИЕ ДАННЫЕ
# ═══════════════════════════════════════════════════════════════════
#
# Главный предохранитель проекта. По умолчанию игнорируется ВСЁ
# содержимое Data/ — так, чтобы случайно закоммитить собственную
# медкарту было невозможно.
#
# Логика обратная привычной: не «перечисляем, что скрыть», а
# «скрываем всё и перечисляем редкие исключения». Ошибка в такой
# схеме приводит к тому, что файл не попадёт в git, — а не к утечке.

Data/**

# Исключения: структура каталогов, шаблоны и база знаний системы.
# Личных данных ни в одном из них нет и быть не должно.
!Data/**/
!Data/**/.gitkeep
!Data/**/README.md
!Data/**/*.example.json
!Data/**/*.example.jsonl
!Data/**/*.example.csv
!Data/**/*.demo.json
!Data/**/*.demo.jsonl
!Data/**/*.demo.csv

# Markdown-шаблоны: протокол визита и файл паттернов. Суффиксы .example
# и .demo носят только шаблоны — реальная запись никогда их не имеет,
# поэтому исключение не ослабляет предохранитель выше.
!Data/**/*.example.md
!Data/**/*.demo.md

# Образцы формата отдельной записи — анализа, протокола визита.
# В отличие от .example они НЕ разворачиваются установщиком: это справка
# «как выглядит запись», а не файл-контейнер, который нужно завести.
# Развёрнутый образец создавал бы анализ, отсутствующий в индексе.
!Data/**/*.reference.json
!Data/**/*.reference.md

# Справочники системы, а не данные пациента
!Data/labs/_marker-aliases.json
!Data/specialists/*.json

# ═══════════════════════════════════════════════════════════════════
#  ОРИГИНАЛЫ ДОКУМЕНТОВ
# ═══════════════════════════════════════════════════════════════════
#
# PDF, сканы и снимки содержат PHI в самом сыром виде: ФИО, даты
# рождения, номера полисов, печати клиник. В git они переживают
# любое удаление из рабочего каталога и всплывают при шаринге истории.

*.pdf
*.dcm
*.jpg
*.jpeg
*.png
*.heic
*.tif
*.tiff
*.dicom

# Кроме иконок и статики дашборда
!Dashboard/public/**

# И кроме иллюстраций документации. Скриншоты сняты на синтетических
# демо-данных вымышленного пациента — реальных сведений на них нет
!docs/img/**

# ═══════════════════════════════════════════════════════════════════
#  РАБОЧИЕ КАТАЛОГИ
# ═══════════════════════════════════════════════════════════════════

# Строка `!<каталог>/**/` обязательна перед разыгноренными файлами:
# git не умеет разыгнорить файл внутри проигнорированного каталога,
# и без неё вложенные .gitkeep молча выпадают — после клонирования
# подкаталогов Cache/alerts, Cache/sessions и Archive/processed просто нет.

Inbox/**
!Inbox/**/
!Inbox/**/.gitkeep

Archive/**
!Archive/**/
!Archive/**/.gitkeep

Cache/**
!Cache/**/
!Cache/**/.gitkeep

Goals/**
!Goals/**/
!Goals/**/.gitkeep

# ═══════════════════════════════════════════════════════════════════
#  СЕКРЕТЫ
# ═══════════════════════════════════════════════════════════════════

.mcp.json
.env
.env.*
!.env.example
*.key
*.pem
credentials.json

# ═══════════════════════════════════════════════════════════════════
#  РАНТАЙМ CLAUDE CODE
# ═══════════════════════════════════════════════════════════════════

# Breadcrumbs сессий содержат абсолютные пути с именем пользователя
.claude/hooks/pending-sessions/*.json
.claude/hooks/session-start-*.tmp
.claude/projects/
.claude/settings.local.json

# ═══════════════════════════════════════════════════════════════════
#  ДАШБОРД
# ═══════════════════════════════════════════════════════════════════

Dashboard/node_modules/
Dashboard/.next/
Dashboard/out/
Dashboard/.env.local
Dashboard/tsconfig.tsbuildinfo

# ═══════════════════════════════════════════════════════════════════
#  СИСТЕМНОЕ
# ═══════════════════════════════════════════════════════════════════

.DS_Store
Thumbs.db
*.tmp
*.bak
*.swp
.vscode/
.idea/
